{
  "name": "mindmymap",
  "version": "1.0.0",
  "description": "Free, open-source, ad-less mind mapping tool \u2014 inspired by GitMind, built on Digimindmap by La Digitale",
  "homepage": "https://mindmymap.ct.ws/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mindmymap/mindmymap.git"
  },
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "vite",
    "build:dist": "vite build --mode dist",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "cap:build": "npm run build:dist && npx cap sync",
    "cap:android": "npm run cap:build && npx cap open android",
    "cap:ios": "npm run cap:build && npx cap open ios",
    "cap:sync": "npx cap sync"
  },
  "dependencies": {
    "clipboard": "^2.0.11",
    "destyle.css": "^2.0.0",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "linkify-html": "^4.3.2",
    "linkifyjs": "^4.3.2",
    "pell": "^1.0.6",
    "voca": "^1.4.1",
    "vue": "^3.5.24",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.6.3",
    "@capacitor/core": "^6.2.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/ios": "^6.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.4",
    "eslint": "^10.0.2",
    "eslint-plugin-vue": "^10.8.0",
    "prettier": "^3.8.1",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.2.0",
    "@capacitor/cli": "^6.2.0"
  },
  "type": "module"
}
