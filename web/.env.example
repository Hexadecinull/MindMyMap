# Do not commit .env to Git — it is generated by CI from repository secrets.
# For a manual deploy: copy this file to web/.env, fill in your value,
# then run npm run build:dist (it will copy .env into dist/ automatically).

# Comma-separated origin domains allowed to call the PHP API.
# Leave empty to allow all origins.
# Example: AUTHORIZED_DOMAINS=mindmymap.ct.ws
AUTHORIZED_DOMAINS=
